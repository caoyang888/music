  "lines": [
    {
      "sequence": 1,
      "text": "归家三天雨未停",
      "section": "归乡·收声",
      "fromBar": 3,
      "throughBar": 4,
      "startSec": 6.315789,
      "endSec": 12.631579
    },
    {
      "sequence": 2,
      "text": "门外有人唤父名",
      "section": "归乡·收声",
      "fromBar": 5,
      "throughBar": 6,
      "startSec": 12.631579,
      "endSec": 18.947369000000002
    },
    {
      "sequence": 3,
      "text": "爹扶门框欲相迎",
      "section": "归乡·收声",
      "fromBar": 7,
      "throughBar": 8,
      "startSec": 18.947368,
      "endSec": 25.263158
    },
    {
      "sequence": 4,
      "text": "来客说要谢恩人",
      "section": "归乡·收声",
      "fromBar": 9,
      "throughBar": 10,
      "startSec": 25.263158,
      "endSec": 31.578948
    },
    {
      "sequence": 5,
      "text": "那夜负你踏碎冰",
      "section": "回营·起鼓",
      "fromBar": 11,
      "throughBar": 12,
      "startSec": 31.578947,
      "endSec": 36.68533
    },
    {
      "sequence": 6,
      "text": "你攥我手听风声",
      "section": "回营·起鼓",
      "fromBar": 13,
      "throughBar": 14,
      "startSec": 36.68533,
      "endSec": 41.791713
    },
    {
      "sequence": 7,
      "text": "点卯无人唤木兰",
      "section": "回营·起鼓",
      "fromBar": 15,
      "throughBar": 16,
      "startSec": 41.791713,
      "endSec": 46.898095999999995
    },
    {
      "sequence": 8,
      "text": "父名出口我来应",
      "section": "回营·起鼓",
      "fromBar": 17,
      "throughBar": 18,
      "startSec": 46.898096,
      "endSec": 52.004478999999996
    },
    {
      "sequence": 9,
      "text": "叫错名字，没认错人",
      "section": "首副歌·横刀",
      "fromBar": 19,
      "throughBar": 20,
      "startSec": 52.004479,
      "endSec": 56.902439
    },
    {
      "sequence": 10,
      "text": "那夜背你上岸是我",
      "section": "首副歌·横刀",
      "fromBar": 21,
      "throughBar": 22,
      "startSec": 56.902438,
      "endSec": 61.800398
    },
    {
      "sequence": 11,
      "text": "认这道虎口的伤痕",
      "section": "首副歌·横刀",
      "fromBar": 23,
      "throughBar": 24,
      "startSec": 61.800398,
      "endSec": 66.698357
    },
    {
      "sequence": 12,
      "text": "你欠的那碗酒还温",
      "section": "首副歌·横刀",
      "fromBar": 25,
      "throughBar": 26,
      "startSec": 66.698357,
      "endSec": 71.596316
    },
    {
      "sequence": 13,
      "text": "叫错名字，没认错人",
      "section": "首副歌·横刀",
      "fromBar": 27,
      "throughBar": 28,
      "startSec": 71.596316,
      "endSec": 76.494276
    },
    {
      "sequence": 14,
      "text": "今朝可唤我一声",
      "section": "首副歌·横刀",
      "fromBar": 29,
      "throughBar": 30,
      "startSec": 76.494275,
      "endSec": 81.392235
    },
    {
      "sequence": 15,
      "text": "爹的手停在门边",
      "section": "桥段·卸甲",
      "fromBar": 33,
      "throughBar": 34,
      "startSec": 86.007619,
      "endSec": 92.674285
    },
    {
      "sequence": 16,
      "text": "我把军牌还他掌间",
      "section": "桥段·卸甲",
      "fromBar": 35,
      "throughBar": 36,
      "startSec": 92.674286,
      "endSec": 99.340952
    },
    {
      "sequence": 17,
      "text": "他把热酒推我面前",
      "section": "桥段·卸甲",
      "fromBar": 37,
      "throughBar": 38,
      "startSec": 99.340952,
      "endSec": 106.00761899999999
    },
    {
      "sequence": 18,
      "text": "问我以后唤何名",
      "section": "桥段·卸甲",
      "fromBar": 39,
      "throughBar": 40,
      "startSec": 106.007619,
      "endSec": 112.674285
    },
    {
      "sequence": 19,
      "text": "叫错名字，没认错人",
      "section": "尾副歌·自报姓名",
      "fromBar": 41,
      "throughBar": 42,
      "startSec": 112.674286,
      "endSec": 117.28967
    },
    {
      "sequence": 20,
      "text": "那夜背你上岸是我",
      "section": "尾副歌·自报姓名",
      "fromBar": 43,
      "throughBar": 44,
      "startSec": 117.28967,
      "endSec": 121.905055
    },
    {
      "sequence": 21,
      "text": "认这道虎口的伤痕",
      "section": "尾副歌·自报姓名",
      "fromBar": 45,
      "throughBar": 46,
      "startSec": 121.905055,
      "endSec": 126.520439
    },
    {
      "sequence": 22,
      "text": "别把那酒敬错了人",
      "section": "尾副歌·自报姓名",
      "fromBar": 47,
      "throughBar": 48,
      "startSec": 126.52044,
      "endSec": 131.135824
    },
    {
      "sequence": 23,
      "text": "若你又问雪夜何人",
      "section": "尾副歌·自报姓名",
      "fromBar": 49,
      "throughBar": 50,
      "startSec": 131.135824,
      "endSec": 135.751208
    },
    {
      "sequence": 24,
      "text": "叫我木兰，我就应声",
      "section": "尾副歌·自报姓名",
      "fromBar": 51,
      "throughBar": 52,
      "startSec": 135.751209,
      "endSec": 140.366593
    }
  ],
  "exactDuration": 146.68238283339866
}
